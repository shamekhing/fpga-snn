# Gowin-generated implementation output.
impl/gwsynthesis/
impl/pnr/
impl/temp/

# Local IDE state and simulator output.
*.gprj.user
*.vvp
*.vcd
src/impl/

# Local model environments and Python caches.
.venv/
__pycache__/
*.py[cod]

# Local datasets, checkpoints, and generated ROM images.
/data/
!/data/.gitkeep
src/data/*
!src/data/.gitkeep
src/data/mnist/*
!src/data/mnist/.gitkeep
src/data/streams/*
!src/data/streams/.gitkeep
src/data/weights/*
!src/data/weights/.gitkeep

# The repository reserves this directory for other local/generated files.
ignore/*
!ignore/.gitkeep
