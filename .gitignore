# Gowin-generated implementation output.
impl/gwsynthesis/
impl/pnr/
impl/temp/

# Local IDE state and simulator output.
*.gprj.user
*.vvp
*.vcd

# Local model environments and Python caches.
.venv/
__pycache__/
*.py[cod]

# Local datasets, checkpoints, and generated ROM images.
data/*
!data/.gitkeep
data/mnist/*
!data/mnist/.gitkeep
data/streams/*
!data/streams/.gitkeep
data/weights/*
!data/weights/.gitkeep

# The repository reserves this directory for other local/generated files.
ignore/*
!ignore/.gitkeep
